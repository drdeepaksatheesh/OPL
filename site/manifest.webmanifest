{
  "name": "OpenPhysiologyLab Reference Labs",
  "short_name": "OPL",
  "description": "Open, transparent physiology Reference Labs built from trusted datasets.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f8fb",
